{
  "name": "playqr-local",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "vars": {
    "ENVIRONMENT": "development",
    "FRONTEND_URL": "http://127.0.0.1:5173/",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "playqr-sharing",
      "database_id": "local-playqr",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}

