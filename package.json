{
  "name": "playqr",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/test-browser.mjs",
    "test:accounts": "node tests/accounts.mjs",
    "test:runtime-auth": "npm run worker:build && node tests/runtime-auth.mjs",
    "check": "npm run lint && npm test && npm run build && npm run worker:build && npm run test:accounts && node tests/runtime-auth.mjs && npm run test:browser",
    "pages:prepare": "node scripts/prepare-pages.mjs",
    "lint": "eslint frontend/src shared worker tests scripts",
    "format": "prettier --write frontend shared worker tests README.md docs",
    "worker:dev": "wrangler dev --config worker/wrangler.local.jsonc",
    "worker:build": "wrangler deploy --dry-run --config worker/wrangler.jsonc --outdir ../worker-build",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jspdf": "4.2.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.0.0",
    "vite": "^6.4.0",
    "wrangler": "^4.0.0"
  }
}
